# Local-only server defaults. Values already exported in the shell win.
VOZTUDIO_HOST=127.0.0.1
VOZTUDIO_PORT=7860
# auto, cpu, cuda, or cuda:0. /health keeps this value in "device".
# "resolved_device" is what the Fish Speech process actually used.
VOZTUDIO_DEVICE=auto
# Set to 1 to allow a non-loopback VOZTUDIO_HOST or FISH_HOST. The start
# script prints a warning. Leave unset for a loopback-only server.
VOZTUDIO_ALLOW_PUBLIC_BIND=
VOZTUDIO_DATA_DIR=./data
VOZTUDIO_CACHE_DIR=./.cache
VOZTUDIO_MAX_UPLOAD_BYTES=26214400
# Read timeout, in seconds, for one Fish Speech request.
VOZTUDIO_FISH_TIMEOUT=900
# How long start.sh waits for the model process to become ready.
FISH_START_TIMEOUT=900
# Inclusive reference length. 10–30 seconds is the recommended range.
VOZTUDIO_VOICE_MIN_SECONDS=10
VOZTUDIO_VOICE_MAX_SECONDS=90
FISH_SPEECH_ROOT=./.cache/fish-speech
FISH_MODEL_ID=fishaudio/s2-pro
FISH_SPEECH_URL=http://127.0.0.1:8080
FISH_HOST=127.0.0.1
FISH_PORT=8080
# Optional bearer token. start.sh passes it to the model server and does not print it.
FISH_SPEECH_API_KEY=
