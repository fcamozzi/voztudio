# Local-only server defaults. Values already exported in the shell win.
# qwen3 is the 1.7B Base clone. qwen3-fast is the 0.6B Base clone.
# voxcpm2 keeps style tags. fish is the S2-Pro HTTP server, for GPU machines.
VOZTUDIO_BACKEND=qwen3
# mlx on Apple Silicon, pytorch on Linux and CUDA. Leave empty to auto-select.
# Set mlx or pytorch only when you want to override that choice.
VOZTUDIO_RUNTIME=
# Optional hub id or local snapshot override. Empty uses the backend default.
VOZTUDIO_MODEL_ID=
# ASR for the trimmed reference. Empty uses Whisper tiny (MLX on Apple Silicon,
# faster-whisper elsewhere). Example override:
# VOZTUDIO_ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
VOZTUDIO_ASR_MODEL=
# Optional JSON object or FastHunting=Fést Rânting lines.
VOZTUDIO_PRONUNCIATIONS=
# Optional directory that already contains the snapshot. Empty uses
# $VOZTUDIO_CACHE_DIR/checkpoints/<backend> when that directory has config.json.
VOZTUDIO_MODEL_DIR=
VOZTUDIO_HOST=127.0.0.1
VOZTUDIO_PORT=7860
# auto, cpu, cuda, cuda:0, or mps. /health keeps this value in "device".
# "resolved_device" is the device the selected backend actually used.
VOZTUDIO_DEVICE=auto
# Set to 1 to allow a non-loopback VOZTUDIO_HOST or FISH_HOST. The start
# script prints a warning. Leave unset for a loopback-only server.
VOZTUDIO_ALLOW_PUBLIC_BIND=
VOZTUDIO_DATA_DIR=./data
VOZTUDIO_CACHE_DIR=./.cache
VOZTUDIO_MAX_UPLOAD_BYTES=26214400
# Read timeout, in seconds, for one Fish Speech request.
VOZTUDIO_FISH_TIMEOUT=900
# How long start.sh waits for the Fish Speech process. Ignored by other backends.
FISH_START_TIMEOUT=900
# Inclusive reference length. 10–30 seconds is the recommended range.
# Synthesis trims to 15 s (Qwen3), 20 s (VoxCPM2), or 30 s (Fish).
VOZTUDIO_VOICE_MIN_SECONDS=10
VOZTUDIO_VOICE_MAX_SECONDS=90
FISH_SPEECH_ROOT=./.cache/fish-speech
FISH_VENV_DIR=./.venv-fish
FISH_MODEL_ID=fishaudio/s2-pro
FISH_SPEECH_URL=http://127.0.0.1:8080
FISH_HOST=127.0.0.1
FISH_PORT=8080
# Optional bearer token. start.sh passes it to the Fish server and does not print it.
FISH_SPEECH_API_KEY=
